#!/usr/bin/env sh
# Typecheck before tests: vitest runs the code, it does not type it, so a type
# error passes here and fails in CI minutes later. That happened on
# 0.12.0-rc.1 — a `spawnSync` option that does not exist in SpawnSyncOptions
# sailed through a green 788-test run because the last local typecheck predated
# the file. Costs a few seconds.
npm run typecheck

npm test

# UDS Standard Check
# Runs the UDS CLI installed in this project (node_modules/.bin) or on PATH.
# It never asks npm to fetch anything: the short name "uds" on the npm registry
# belongs to an unrelated package, and running that short name through npx would download it.
(
  PATH="$PWD/node_modules/.bin:$PATH"
  if command -v universal-dev-standards >/dev/null 2>&1; then
    universal-dev-standards check
    exit $?
  fi
  echo "[UDS] Pre-commit check cannot run: the UDS CLI (universal-dev-standards) is not installed." >&2
  echo "[UDS] Install it:  npm install -g universal-dev-standards" >&2
  exit 1
) || exit $?
# End UDS Standard Check
